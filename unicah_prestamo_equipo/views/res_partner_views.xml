<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_prestamo_equipo" model="ir.ui.view">
        <field name="name">res.partner.form.prestamo.equipo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Préstamos de Equipo" name="prestamos_equipo">
                    <group>
                        <field name="total_prestamos_equipo"/>
                    </group>
                    <field name="prestamo_equipo_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="equipo"/>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="estado"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>