<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_unicah_prestamo_list" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.list</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <list string="Préstamos de Equipo">
                <field name="name"/>
                <field name="solicitante_id"/>
                <field name="equipo"/>
                <field name="fecha_prestamo"/>
                <field name="fecha_devolucion"/>
                <field name="dias_prestamo"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_unicah_prestamo_form" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.form</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <form string="Préstamo de Equipo UNICAH">
                <header>
                    <button name="action_prestar" string="Entregar equipo" type="object" class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_devolver" string="Registrar devolución" type="object" class="btn-secondary" invisible="estado != 'prestado'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="solicitante_id"/>
                            <field name="equipo"/>
                        </group>
                        <group>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="dias_prestamo"/>
                        </group>
                    </group>
                    <group>
                        <field name="observaciones"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_unicah_prestamo_equipo" model="ir.actions.act_window">
        <field name="name">Préstamos de Equipo</field>
        <field name="res_model">unicah.prestamo.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_unicah_prestamo_root" name="Préstamos UNICAH" sequence="25"/>
    <menuitem
        id="menu_unicah_prestamo_equipo"
        name="Solicitudes de préstamo"
        parent="menu_unicah_prestamo_root"
        action="action_unicah_prestamo_equipo"
        sequence="10"/>
</odoo>